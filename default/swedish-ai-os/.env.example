# Core provider selection: kb_whisper | openai
SVAI_ASR_PROVIDER=kb_whisper

# kb_whisper settings
SVAI_KB_WHISPER_MODEL=KBLab/kb-whisper-medium
SVAI_KB_WHISPER_REVISION=main

# LLM provider: openai | ollama
SVAI_LLM_PROVIDER=openai
SVAI_LLM_MODEL=gpt-4.1-mini
SVAI_OLLAMA_MODEL=llama3.1
SVAI_OLLAMA_HOST=http://127.0.0.1:11434

# TTS provider: piper | openai
SVAI_TTS_PROVIDER=piper
SVAI_PIPER_MODEL_PATH=/opt/piper/voices/sv_SE-nst-medium.onnx
SVAI_OPENAI_TTS_MODEL=gpt-4o-mini-tts
SVAI_OPENAI_TTS_VOICE=alloy

# OpenAI speech model used when SVAI_ASR_PROVIDER=openai
SVAI_OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Keep responses Swedish unless explicitly switched
SVAI_SYSTEM_PROMPT=Du ar en svensk röstassistent i ett Arch-baserat system. Svara kort, tydligt och pa svenska.

# Required for OpenAI providers
OPENAI_API_KEY=
